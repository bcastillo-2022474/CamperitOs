---
// Camperitos icon mark (drumstick). Inherits color from `currentColor`.
interface Props {
	size?: number;
	class?: string;
}
const { size = 40, class: className } = Astro.props;
---

<svg
	class={className}
	viewBox="220 220 1160 1160"
	width={size}
	height={size}
	aria-hidden="true"
	focusable="false"
>
	<path fill="currentColor" d="M1000,1000V625A375,375 0 1 0 625,1000Z"></path>
	<path fill="currentColor" d="M1003,1000H1073L1250,1175L1170,1250L1003,1085Z"></path>
	<g fill="currentColor">
		<circle cx="1295" cy="1180" r="56"></circle>
		<circle cx="1190" cy="1297" r="57"></circle>
		<circle cx="1295" cy="1297" r="56"></circle>
		<circle cx="1240" cy="1235" r="50"></circle>
	</g>
</svg>
