---
import Landing from '../layouts/Landing.astro';
import Mark from '../components/Mark.astro';
import Wordmark from '../components/Wordmark.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site!.href.replace(/\/$/, '');
const siteUrl = `${site}${base}/`;

const REPO_URL = 'https://github.com/bcastillo-2022474/CamperitOs';
const COMMUNITY_URL = 'https://www.instagram.com/sudoers.os';
const docsUrl = `${base}/proyecto/estado/`;

const title = 'Camperitos: una distro de Linux hecha en Guatemala';
const description =
	'Camperitos es una distribución de Linux basada en Fedora, hecha en Guatemala: un escritorio con criterio, listo para programar. Seguí el proyecto y sumate a la comunidad.';

const cards = [
	{
		n: '01',
		title: 'Desde aquí, para aquí',
		text: 'Nace en Guatemala para quienes programan, estudian y construyen en el país, empezando por la UVG.',
	},
	{
		n: '02',
		title: 'Un escritorio con criterio',
		text: 'La meta es que instales y trabajes: terminal, editor y entorno ya afinados.',
	},
	{
		n: '03',
		title: 'Se aprende construyéndola',
		text: 'Cada pieza se escribe en comunidad, de la configuración a, algún día, las capas bajas del sistema.',
	},
];

const roadmap = [
	{
		n: '01',
		title: 'Dotfiles',
		text: 'Nuestra configuración, publicada y reproducible. El primer ladrillo.',
		badge: 'siguiente',
		state: 'next',
	},
	{
		n: '02',
		title: 'Instalador',
		text: 'Un solo paso para aplicar todo sobre un sistema existente.',
		badge: 'después',
		state: 'later',
	},
	{
		n: '03',
		title: 'Distro propia',
		text: 'Camperitos como distro completa, lista para instalar desde cero.',
		badge: 'meta final',
		state: 'goal',
	},
];

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		'@id': `${siteUrl}#website`,
		url: siteUrl,
		name: 'Camperitos',
		alternateName: 'CamperitOs',
		description,
		inLanguage: 'es-GT',
		publisher: { '@id': `${siteUrl}#organization` },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Organization',
		'@id': `${siteUrl}#organization`,
		name: 'Camperitos',
		alternateName: 'CamperitOs',
		url: siteUrl,
		logo: `${site}${base}/favicon.png`,
		description:
			'Proyecto comunitario de una distribución de Linux basada en Fedora, hecha en Guatemala.',
		areaServed: 'GT',
		parentOrganization: {
			'@type': 'Organization',
			name: 'sudoers',
			description: 'Comunidad Linux de Guatemala',
			sameAs: [COMMUNITY_URL],
		},
		sameAs: [REPO_URL],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'WebPage',
		'@id': `${siteUrl}#webpage`,
		url: siteUrl,
		name: title,
		description,
		inLanguage: 'es-GT',
		isPartOf: { '@id': `${siteUrl}#website` },
		about: { '@id': `${siteUrl}#organization` },
	},
];
---

<Landing title={title} description={description} jsonLd={jsonLd}>
	<header class="wrap top">
		<a class="home" href={`${base}/`} aria-label="Camperitos, inicio">
			<Mark size={40} />
		</a>
		<nav class="nav" aria-label="Principal">
			<a href="#que-es">Qué es</a>
			<a href="#ruta">Ruta</a>
			<a href={docsUrl}>Docs</a>
			<a href="#unirse" class="btn btn-primary btn-sm">Unirme</a>
		</nav>
	</header>

	<main id="contenido">
		<section class="wrap hero" aria-labelledby="titulo">
			<Wordmark />
			<div class="hero-row">
				<h1 id="titulo">
					<span class="sr-only">Camperitos: </span>Una distro de Linux hecha en Guatemala.
				</h1>
				<div class="hero-side">
					<p>
						Un escritorio con criterio, listo para programar. Hoy es una idea y unos dotfiles por publicar; el destino
						es una distro completa.
					</p>
					<div class="actions">
						<a href={COMMUNITY_URL} class="btn btn-primary" rel="noopener">Unirme a la comunidad</a>
						<a href="#ruta" class="btn btn-ghost">Ver la ruta</a>
					</div>
				</div>
			</div>
		</section>

		<section id="que-es" class="wrap block" aria-labelledby="que-es-titulo">
			<h2 id="que-es-titulo" class="label">Qué es<span class="sr-only"> Camperitos</span></h2>
			<ul class="cards">
				{
					cards.map((c) => (
						<li class="card">
							<span class="card-n">{c.n}</span>
							<h3>{c.title}</h3>
							<p>{c.text}</p>
						</li>
					))
				}
			</ul>
		</section>

		<section id="ruta" class="wrap block" aria-labelledby="ruta-titulo">
			<div class="route-head">
				<h2 id="ruta-titulo" class="big">Hoja de ruta</h2>
				<p class="mono">Estamos conceptualizando: esto puede cambiar.</p>
			</div>
			<ol class="route">
				{
					roadmap.map((r) => (
						<li class={`step step-${r.state}`}>
							<div class="step-title">
								<Mark size={52} />
								<h3>
									{r.n} · {r.title}
								</h3>
							</div>
							<p>{r.text}</p>
							<div>
								<span class={`badge badge-${r.state}`}>{r.badge}</span>
							</div>
						</li>
					))
				}
			</ol>
		</section>

		<section id="unirse" class="wrap join-wrap" aria-labelledby="unirse-titulo">
			<div class="join">
				<div class="join-copy">
					<h2 id="unirse-titulo">Ayúdanos a construirla.</h2>
					<p>
						Camperitos se está pensando ahora mismo. Entra a la comunidad, opina y aporta la primera línea.
					</p>
					<div class="actions">
						<a href={COMMUNITY_URL} class="btn btn-primary-dark" rel="noopener">Unirme a la comunidad</a>
						<a href={docsUrl} class="btn btn-ghost-dark">Leer la documentación</a>
					</div>
				</div>
				<div class="join-mark">
					<Mark size={280} />
				</div>
			</div>
		</section>
	</main>

	<footer class="foot">
		<div class="wrap foot-row">
			<span>
				Camperitos es un proyecto de <a href={COMMUNITY_URL} rel="noopener">sudoers</a>, comunidad Linux de Guatemala.
			</span>
			<span>
				<a href={REPO_URL} rel="noopener">Código en GitHub</a> · 2026
			</span>
		</div>
	</footer>
</Landing>

<style>
	.wrap {
		max-width: 1200px;
		margin: 0 auto;
		padding-inline: 40px;
	}

	/* Header */
	.top {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 16px 32px;
		padding-block: 32px;
	}
	.home {
		display: block;
		line-height: 0;
	}
	.nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 36px;
	}
	.nav a:not(.btn) {
		min-height: 44px;
		display: inline-flex;
		align-items: center;
		font-size: 16px;
		font-weight: 500;
		text-decoration: none;
		white-space: nowrap;
	}
	.nav a:not(.btn):hover {
		text-decoration: underline;
		text-underline-offset: 6px;
	}

	/* Buttons */
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 52px;
		padding: 0 28px;
		border: 3px solid var(--ink);
		border-radius: 999px;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 18px;
		color: var(--ink);
		text-decoration: none;
		box-shadow: 4px 4px 0 var(--ink);
		transition:
			transform 0.12s ease,
			box-shadow 0.12s ease;
	}
	.btn:hover {
		transform: translate(2px, 2px);
		box-shadow: 2px 2px 0 var(--ink);
	}
	.btn-sm {
		min-height: 44px;
		padding: 0 22px;
		font-size: 16px;
	}
	.btn-primary {
		background: var(--achiote);
	}
	.btn-ghost {
		background: var(--white);
	}
	.btn-primary-dark,
	.btn-ghost-dark {
		border-color: var(--cream);
		box-shadow: 4px 4px 0 var(--cream);
	}
	.btn-primary-dark:hover,
	.btn-ghost-dark:hover {
		box-shadow: 2px 2px 0 var(--cream);
	}
	.btn-primary-dark {
		background: var(--achiote);
		color: var(--ink);
	}
	.btn-ghost-dark {
		background: transparent;
		color: var(--cream);
	}

	/* Hero */
	.hero {
		padding-block: 72px 112px;
		display: flex;
		flex-direction: column;
		gap: 80px;
	}
	.hero :global(.wordmark) {
		display: block;
		width: 100%;
		height: auto;
		color: var(--ink);
	}
	.hero-row {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: space-between;
		gap: 40px 64px;
	}
	h1 {
		margin: 0;
		flex: 1 1 420px;
		font-weight: 500;
		font-size: clamp(34px, 4.2vw, 56px);
		line-height: 1.08;
		letter-spacing: -0.03em;
		text-wrap: balance;
	}
	.hero-side {
		flex: 1 1 380px;
		max-width: 520px;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 32px;
	}
	.hero-side p {
		margin: 0;
		color: var(--muted);
		text-wrap: pretty;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
	}

	/* Sections */
	.block {
		padding-bottom: 112px;
	}
	.label {
		margin: 0 0 32px;
		padding-top: 24px;
		border-top: 2px solid var(--ink);
		font-weight: 600;
		font-size: 16px;
	}
	.cards {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
		gap: 24px;
	}
	.card {
		display: flex;
		flex-direction: column;
		gap: 16px;
		min-height: 300px;
		padding: 40px 36px 44px;
		background: var(--ink);
		color: var(--cream);
		border-radius: 32px;
	}
	.card-n {
		font-size: 15px;
		font-weight: 600;
		color: var(--achiote);
	}
	.card h3 {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 34px;
		line-height: 1.1;
	}
	.card p {
		margin: 0;
		color: var(--cream-muted);
		text-wrap: pretty;
	}

	/* Roadmap */
	.route-head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 12px 32px;
		margin-bottom: 36px;
	}
	.big {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(34px, 4.4vw, 56px);
		line-height: 1.05;
		letter-spacing: -0.01em;
	}
	.mono {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 15px;
		color: var(--muted);
	}
	.route {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 3px solid var(--ink);
	}
	.step {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
		gap: 12px 32px;
		align-items: center;
		padding-block: 28px;
		border-bottom: 3px solid var(--ink);
	}
	.step-title {
		display: flex;
		align-items: center;
		gap: 20px;
	}
	.step-title :global(svg) {
		flex: none;
		display: block;
	}
	.step-next .step-title :global(svg) {
		color: var(--achiote);
	}
	.step-later .step-title :global(svg) {
		opacity: 0.7;
	}
	.step-goal .step-title :global(svg) {
		opacity: 0.3;
	}
	.step h3 {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 30px;
		line-height: 1.1;
	}
	.step p {
		margin: 0;
		color: var(--muted);
		text-wrap: pretty;
	}
	.badge {
		display: inline-block;
		padding: 6px 16px;
		border: 2px solid var(--ink);
		border-radius: 999px;
		font-family: var(--font-mono);
		font-size: 14px;
		font-weight: 500;
	}
	.badge-next {
		background: var(--achiote);
	}
	.badge-goal {
		border-style: dashed;
	}

	/* Join */
	.join-wrap {
		padding-bottom: 96px;
	}
	.join {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
		gap: 48px;
		align-items: center;
		padding: 72px 64px;
		background: var(--ink);
		color: var(--cream);
		border-radius: 40px;
	}
	.join-copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 24px;
	}
	.join h2 {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(40px, 5.4vw, 76px);
		line-height: 1;
		letter-spacing: -0.01em;
		text-wrap: balance;
	}
	.join p {
		margin: 0;
		max-width: 28em;
		font-size: 19px;
		color: var(--cream-muted);
		text-wrap: pretty;
	}
	.join .actions {
		padding-top: 8px;
	}
	.join-mark {
		display: flex;
		justify-content: center;
		color: var(--achiote);
	}
	.join-mark :global(svg) {
		display: block;
		max-width: 100%;
		height: auto;
	}

	/* Footer */
	.foot {
		border-top: 2px solid var(--ink);
	}
	.foot-row {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 12px 32px;
		padding-block: 32px 48px;
		font-size: 15px;
		color: var(--muted);
	}
	.foot-row a {
		color: var(--muted);
	}

	@media (max-width: 640px) {
		.wrap {
			padding-inline: 20px;
		}
		.top {
			padding-block: 20px;
		}
		.nav {
			gap: 4px 20px;
		}
		.hero {
			padding-block: 40px 72px;
			gap: 48px;
		}
		.block {
			padding-bottom: 72px;
		}
		.card {
			padding: 32px 28px 36px;
			min-height: 0;
		}
		.join {
			padding: 44px 28px;
			border-radius: 32px;
		}
		.join-mark :global(svg) {
			width: 180px;
		}
	}
</style>
